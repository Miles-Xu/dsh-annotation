diff --git a/test/light-theme-tokens.test.mjs b/test/light-theme-tokens.test.mjs
new file mode 100644
index 0000000..f8d3587
--- /dev/null
+++ b/test/light-theme-tokens.test.mjs
@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import test from 'node:test'
+
+const source = readFileSync(new URL('../client.js', import.meta.url), 'utf8')
+
+test('light theme surfaces use visible alias tokens (#93)', () => {
+  assert.doesNotMatch(source, /--dsw-alias-border-inverted/)
+  assert.doesNotMatch(source, /--dsw-alias-label-dimmed/)
+  assert.match(source, /--dsw-alias-border-l3/)
+  assert.match(source, /--dsw-alias-brand-primary/)
+  assert.match(source, /--dsw-alias-bg-module-platform/)
+})
