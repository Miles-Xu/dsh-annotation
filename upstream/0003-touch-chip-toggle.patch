diff --git a/test/touch-chip-close-browser.mjs b/test/touch-chip-close-browser.mjs
new file mode 100644
index 0000000..523b341
--- /dev/null
+++ b/test/touch-chip-close-browser.mjs
@@ -0,0 +1,48 @@
+// Regression for #91: touch has no mouseleave, so the pending-annotation panel
+// could only be closed by switching sessions. A tap toggles it, and a tap
+// outside closes it; mouse hover behavior is unchanged.
+import assert from 'node:assert/strict'
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright')
+const browser = await chromium.launch({ channel: 'chrome', headless: true })
+try {
+  const page = await browser.newPage({ viewport: { width: 1000, height: 800 } })
+  const errors = []
+  page.on('pageerror', error => errors.push(String(error)))
+  await page.route('http://annotation.test/', route => route.fulfill({ contentType: 'text/html; charset=utf-8', body: `
+    <style>body{margin:0} [data-composer-card]{position:fixed;left:200px;bottom:24px;width:600px;height:140px;background:#fff}</style>
+    <div data-composer-card><div data-composer-input contenteditable="true"></div></div>` }))
+  await page.goto('http://annotation.test/')
+  await page.evaluate(() => {
+    localStorage.setItem('dsh.annotation.pending.v1.session', JSON.stringify([
+      { id: 'a', text: '原文', note: '批注' },
+    ]))
+    window.__ModuleLoader__ = { load(entry) { window.api = entry.factory(() => ({})) } }
+  })
+  await page.addScriptTag({ path: new URL('../client.js', import.meta.url).pathname })
+  await page.evaluate(() => {
+    window.api.apply({
+      sessions: {
+        list: { getSnapshot: () => ({ current: 'session' }), subscribe: () => () => {} },
+        scope: () => ({}),
+      },
+      locale: { getSnapshot: () => ({ active: 'zh' }), subscribe: () => () => {} },
+    })
+  })
+  const chip = page.locator('[data-annotation-chip]')
+  await chip.waitFor({ state: 'visible' })
+  const tip = page.locator('.dsh-ann-tip')
+
+  await page.evaluate(() => {
+    document.querySelector('[data-annotation-chip]')
+      .dispatchEvent(new PointerEvent('click', { pointerType: 'touch', bubbles: true }))
+  })
+  await tip.waitFor({ state: 'visible' })
+  await page.evaluate(() => {
+    document.body.dispatchEvent(new PointerEvent('pointerdown', { pointerType: 'touch', bubbles: true }))
+  })
+  await tip.waitFor({ state: 'hidden' })
+  assert.deepEqual(errors, [])
+  console.log('PASS: touch tap opens the pending panel; outside tap closes it (#91)')
+} finally {
+  await browser.close()
+}
